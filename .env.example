# ===== ScholarStance 配置示例 =====
# 复制本文件为 .env 并填入真实值:  cp .env.example .env

# ---- LLM 提供商: deepseek 或 glm ----
LLM_PROVIDER=deepseek

# ---- DeepSeek ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ---- GLM (智谱) ----
GLM_API_KEY=xxxxxxxx.xxxxxxxx
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_CHAT_MODEL=glm-4-flash

# ---- Embedding (初版用 API; 后期可换本地自训模型) ----
# 默认复用 GLM 的 embedding, 也可指向任意 OpenAI 兼容 embedding 端点
EMBED_PROVIDER=glm
EMBED_MODEL=embedding-3
EMBED_API_KEY=xxxxxxxx.xxxxxxxx
EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- 运行参数 ----
READER_CONCURRENCY=4          # Reader 并行上限 (注意 API 限流)
MAX_LOOP_ROUNDS=12            # 单 agent loop 最大轮次
CRITIC_MAX_RETRY=2            # Critic 打回重做上限
CONTEXT_TOKEN_BUDGET=24000    # 上下文 token 预算, 超出触发压缩

# ---- M4 稳定性 / 高可用 ----
LLM_MAX_RETRIES=3             # chat/embed 最大重试次数 (429/5xx 指数退避)
LLM_BACKOFF_BASE=1.0          # 退避基数秒 (1s/2s/4s...)
LLM_MIN_INTERVAL=0.0          # 客户端最小请求间隔秒 (限流; 0=关闭)
FALLBACK_CHAT_MODEL=glm-4-flash  # 主模型连续失败时降级到的兜底模型

# ---- M4 成本 (缓存) ----
CACHE_ENABLED=1              # Embedding/检索缓存开关
RETRIEVAL_CACHE_TTL=600      # 检索结果缓存有效期 (秒)

# ---- M4 可观测 ----
LOG_LEVEL=INFO              # 结构化日志级别
LOG_TO_FILE=1              # 是否同时写 storage/scholarstance.log

# ---- 路径 ----
STORAGE_DIR=./storage
CHROMA_DIR=./storage/chroma
SQLITE_PATH=./storage/scholarstance.db

# ---- 飞书 (可选, M3) ----
FEISHU_WEBHOOK_URL=
